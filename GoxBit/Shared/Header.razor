@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inject NavigationManager NavigationManager

<div class="header-wrapper">
    <MudAppBar Fixed="true" Dense="true" Elevation="0" Class="header header-bar">
        <div class="logo">
            <MudLink Class="GoxBit" Href="/" Underline="Underline.None">GoxBit</MudLink>
        </div>

        <MudSpacer />

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <nav class="center-menu" aria-label="Primary navigation">
                <MudNavLink Class="custom-header-text" Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
                <MudNavLink Class="custom-header-text" Href="Projects" Match="NavLinkMatch.Prefix">Projects</MudNavLink>
                <MudNavLink Class="custom-header-text" Href="Models" Match="NavLinkMatch.Prefix">Models</MudNavLink>
                <MudNavLink Class="custom-header-text" Href="Background" Match="NavLinkMatch.Prefix">Background</MudNavLink>
            </nav>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudMenu Icon="@Icons.Material.Filled.Menu"
                     Color="Color.Inherit"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     AriaLabel="Open navigation menu">
                <MudMenuItem OnClick='() => NavigateTo("/")'>Home</MudMenuItem>
                <MudMenuItem OnClick='() => NavigateTo("/Projects")'>Projects</MudMenuItem>
                <MudMenuItem OnClick='() => NavigateTo("/Models")'>Models</MudMenuItem>
                <MudMenuItem OnClick='() => NavigateTo("/Background")'>Background</MudMenuItem>
            </MudMenu>
        </MudHidden>
    </MudAppBar>
</div>

@code {
    private void NavigateTo(string uri) => NavigationManager.NavigateTo(uri);
}
