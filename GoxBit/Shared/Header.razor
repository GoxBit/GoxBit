@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inject NavigationManager NavigationManager

<div class="gb-header-wrapper header-wrapper">
    <MudAppBar Fixed="true" Dense="false" Elevation="0" Class="gb-header header header-bar">
        <div class="logo">
            <MudLink Class="gb-logo GoxBit" Href="/" Underline="Underline.None">GoxBit</MudLink>
        </div>

        <MudSpacer />

        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <div class="center-menu" role="navigation" aria-label="Primary navigation">
                <div class="center-grid">
                    <MudLink Class="gb-nav-link custom-header-text" Href="/#story" Underline="Underline.None">Story</MudLink>
                    <MudLink Class="gb-nav-link custom-header-text" Href="/#reel" Underline="Underline.None">Reel</MudLink>
                    <MudNavLink Class="gb-nav-link custom-header-text" Href="Projects" Match="NavLinkMatch.Prefix">Projects</MudNavLink>
                    <MudNavLink Class="gb-nav-link custom-header-text" Href="Models" Match="NavLinkMatch.Prefix">Models</MudNavLink>
                    <MudNavLink Class="gb-nav-link custom-header-text" Href="Background" Match="NavLinkMatch.Prefix">Background</MudNavLink>
                    <MudLink Class="gb-cta" Href="/#work" Underline="Underline.None">Work</MudLink>
                </div>
            </div>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <div class="mobile-menu">
                <MudMenu Class="hamburger-menu"
                         Icon="@Icons.Material.Filled.Menu"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         AriaLabel="Open navigation menu">
                    <MudMenuItem OnClick='() => NavigateTo("/#story")'>Story</MudMenuItem>
                    <MudMenuItem OnClick='() => NavigateTo("/#reel")'>Reel</MudMenuItem>
                    <MudMenuItem OnClick='() => NavigateTo("/Projects")'>Projects</MudMenuItem>
                    <MudMenuItem OnClick='() => NavigateTo("/Models")'>Models</MudMenuItem>
                    <MudMenuItem OnClick='() => NavigateTo("/Background")'>Background</MudMenuItem>
                </MudMenu>
            </div>
        </MudHidden>
    </MudAppBar>
</div>

@code {
    private void NavigateTo(string uri) => NavigationManager.NavigateTo(uri);
}
