<section class="gb-band gb-band--bg" id="reel" aria-label="Showreel">
    <div class="gb-band__inner">
        <p class="gb-kicker">Showreel</p>
        <h2 class="gb-title">Watch the work move</h2>
        <div class="gb-video-frame">
            @if (string.IsNullOrWhiteSpace(VideoUrl))
            {
                <div class="d-flex flex-column align-center justify-center" style="position:absolute;inset:0;padding:2rem;text-align:center;">
                    <p class="gb-kicker" style="margin:0 0 0.75rem;">Your showreel here</p>
                    <p class="gb-body" style="margin:0;max-width:28rem;">Replace <code>VideoUrl</code> on Home with your YouTube or Vimeo embed link.</p>
                </div>
            }
            else
            {
                <iframe src="@VideoUrl"
                        title="GoxBit showreel"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
            }
        </div>
    </div>
</section>

@code {
    [Parameter]
    public string? VideoUrl { get; set; }
}
