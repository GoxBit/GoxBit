@using GoxBit.Shared
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <Header />

    <MudMainContent Class="pa-0">
        @Body
    </MudMainContent>

    <MudAppBar Bottom="true" Class="ew-footer d-flex align-center justify-center gap-2" Fixed="false" Elevation="0">
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Href="https://github.com" Target="_blank" />
        <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Href="https://linkedin.com" Target="_blank" />
        <MudIconButton Icon="@Icons.Material.Filled.Palette" Href="https://artstation.com" Target="_blank" />
        <MudIconButton Icon="@Icons.Custom.Brands.X" Href="https://x.com" Target="_blank" />
    </MudAppBar>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _isDarkMode = false;
    private MudTheme? _theme;

    protected override void OnInitialized()
    {
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#4cb4af",
        Secondary = "#ff7222",
        Tertiary = "#e65c49",
        Black = "#0c0c0d",
        Background = "#fffde5",
        Surface = "#ffffff",
        AppbarText = "#0c0c0d",
        AppbarBackground = "rgba(255, 253, 229, 0.95)",
        DrawerBackground = "#fffde5",
        TextPrimary = "#0c0c0d",
        TextSecondary = "#555555",
        GrayLight = "#e8e4d4",
        GrayLighter = "#f5f2e8",
        Divider = "#d4cfc0",
        ActionDefault = "#302635",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#4cb4af",
        Secondary = "#ff7222",
        Surface = "#302635",
        Background = "#0c0c0d",
        BackgroundGray = "#1a1a1a",
        AppbarText = "#fffde5",
        AppbarBackground = "rgba(12, 12, 13, 0.95)",
        DrawerBackground = "#0c0c0d",
        TextPrimary = "#fffde5",
        TextSecondary = "#ccc9b8",
        GrayLight = "#302635",
        GrayLighter = "#1a1a1a",
        Divider = "#3a3540",
    };
}
