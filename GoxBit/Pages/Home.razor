@using GoxBit.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@page "/"

<PageTitle>GoxBit — Luis Duran</PageTitle>

<section class="hero-section">
    <div class="hero-content">
        <div class="fade-in">
            <h1 class="ew-title">
                <span class="hero-title-line1">Next stop…</span>
                <span class="hero-title-line2">GoxBit!</span>
            </h1>
            <p class="hero-subtitle fade-in-delay">
                I'm <strong>Luis Duran</strong>, a multidisciplinary game developer blending art and technology.
                Unreal Engine, Unity, 3D modeling, VFX and stylized worlds.
            </p>
            <div class="hero-actions fade-in-delay">
                <PixelButton Href="/Projects" Variant="teal">View Projects</PixelButton>
                <PixelButton Href="/Models">View Models</PixelButton>
            </div>
            <div class="hero-skills fade-in-delay">
                @foreach (var skill in _skills)
                {
                    <span class="skill-chip">@skill</span>
                }
            </div>
        </div>
        <img src="images/profile.png" alt="Luis Duran" class="hero-profile" />
    </div>
</section>

<section class="section-cream">
    <MudContainer MaxWidth="MaxWidth.Large">
        <h2 class="section-title ew-title">About</h2>
        <p class="section-subtitle">
            From concept to final optimization — visual impact and technical excellence across platforms.
        </p>
        <MudText Typo="Typo.body1" Style="max-width: 720px; line-height: 1.8;">
            I specialize in stylized character and prop creation, advanced material and particle systems,
            and immersive visual storytelling through procedural materials and VFX.
        </MudText>
        <div class="hero-actions" style="margin-left: 0; margin-top: 32px;">
            <PixelButton Href="/Background" Variant="orange">My Background</PixelButton>
        </div>
    </MudContainer>
</section>

@code {
    private readonly string[] _skills = ["Unreal Engine", "Unity", "3D Modeling", "Substance", "VFX", "Blender"];
}
