@page "/Models"
@using GoxBit.Components
@using GoxBit.Pages
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<PageTitle>Models — GoxBit</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="section-cream" Style="min-height: 60vh;">
    <div class="ew-page-header">
        <h1 class="ew-title">3D Models</h1>
        <p>Interactive showcases — explore in 3D.</p>
    </div>

    <MudCarousel Class="mud-width-full my-5 model-carousel" AutoCycle="false" TData="object" ShowBullets="false">
        <NextButtonTemplate>
            <MudIconButton Icon="@Icons.Material.Filled.SkipNext" Color="Color.Primary" Size="Size.Large" />
        </NextButtonTemplate>
        <PreviousButtonTemplate>
            <MudIconButton Icon="@Icons.Material.Filled.SkipPrevious" Color="Color.Primary" Size="Size.Large" />
        </PreviousButtonTemplate>
        <ChildContent>
            @foreach (var item in Showcase)
            {
                <MudCarouselItem Transition="Transition.Fade">
                    <div class="model-slide">
                        <p class="ew-mono model-slide-name">@item.Name</p>
                        <div class="sketchfab-embed-wrapper model-highlight">
                            <iframe title="@item.Name" frameborder="0" allowfullscreen
                                    allow="autoplay; fullscreen; xr-spatial-tracking"
                                    src="@item.Url"></iframe>
                        </div>
                    </div>
                </MudCarouselItem>
            }
        </ChildContent>
    </MudCarousel>

    @if (!showAllModels)
    {
        <div class="d-flex justify-center my-4">
            <PixelButton OnClick="ShowModels">Show all models</PixelButton>
        </div>
    }

    @if (showAllModels)
    {
        <div Class="d-flex justify-center align-content-center flex-wrap flex-grow-1 gap-4 py-5">
            @foreach (var item in Showcase)
            {
                <MudPaper Class="model-grid-item" Elevation="0">
                    <Model Name="@item.Name" Url="@item.Url" Tools="item.Tools" />
                </MudPaper>
            }
        </div>
    }
</MudContainer>

<style>
    .model-carousel {
        height: 600px;
    }

    .model-slide {
        width: 100%;
        height: 600px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .model-slide-name {
        color: var(--ew-text-dark);
        margin-bottom: 12px;
        font-size: 0.85rem;
    }

    .model-highlight {
        width: 100%;
        height: 560px;
        border: 2px solid var(--ew-text-dark);
        box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    }

    .model-grid-item {
        width: 34rem;
        border: 2px solid var(--ew-text-dark);
        box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    }
</style>
